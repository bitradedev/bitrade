[Unit]
Description=BI Trade paper-trading service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitrade
Group=bitrade
WorkingDirectory=/opt/bitrade/app
EnvironmentFile=/etc/bitrade/bitrade.env
ExecStart=/opt/bitrade/runtime/node-v24.21.0-linux-x64/bin/node /opt/bitrade/app/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bitrade

[Install]
WantedBy=multi-user.target
