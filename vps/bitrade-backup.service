[Unit]
Description=Verify a BI Trade paper ledger backup

[Service]
Type=oneshot
User=bitrade
Group=bitrade
WorkingDirectory=/opt/bitrade/app
Environment=BI_TRADE_DB_PATH=/var/lib/bitrade/bitrade.sqlite
ExecStart=/opt/bitrade/runtime/node-v24.21.0-linux-x64/bin/node /opt/bitrade/app/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bitrade
