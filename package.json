{
  "name": "bitrade",
  "version": "0.2.0",
  "private": true,
  "description": "BSC AI agent paper-trading platform",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm --dir paper-terminal install --frozen-lockfile",
    "build": "pnpm --dir paper-terminal build",
    "build:agent-desk": "esbuild bi-trade/web-src/agent-desk.js --bundle --minify --format=esm --target=es2022 --outfile=bi-trade/web/agent-desk.js",
    "test": "node --test --test-isolation=none bi-trade/test/*.test.mjs",
    "start": "node bi-trade/server.mjs",
    "start:market": "pnpm --dir paper-terminal start",
    "build:cloud": "wrangler deploy --dry-run --outdir .cloud-build",
    "test:cloud": "node --test --test-isolation=none cloudflare/test/*.test.mjs",
    "cloud:dev": "wrangler dev --port 8796 --ip 127.0.0.1 --local-upstream 127.0.0.1:8796 --upstream-protocol http",
    "cloud:deploy": "wrangler deploy",
    "test:all": "pnpm test && pnpm test:cloud && pnpm --dir paper-terminal test",
    "format:core": "prettier --write bi-trade/platform*.mjs bi-trade/lib/*.mjs cloudflare/*.mjs cloudflare/*.ts",
    "check:format": "prettier --check bi-trade/platform*.mjs bi-trade/lib/*.mjs cloudflare/*.mjs cloudflare/*.ts"
  },
  "dependencies": {
    "gmgn-cli": "^1.6.6",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "^3.9.9",
    "three": "0.186.1",
    "wrangler": "^4.149.0"
  }
}
