{
  "name": "bitrade",
  "version": "0.2.0",
  "private": true,
  "description": "BSC AI agent paper-trading platform",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm --dir paper-terminal install --frozen-lockfile",
    "build": "pnpm --dir paper-terminal build",
    "test": "node --test --test-isolation=none bi-trade/test/*.test.mjs",
    "start": "node bi-trade/server.mjs",
    "start:market": "pnpm --dir paper-terminal start"
  },
  "dependencies": {
    "gmgn-cli": "^1.6.6"
  }
}
